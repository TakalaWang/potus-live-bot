<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.potus-agent</string>

  <!-- absolute path to scripts/run-agent.sh in your checkout -->
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/potus-live-bot/scripts/run-agent.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PATH/TO/potus-live-bot</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/PATH/TO/potus-live-bot/data/agent.log</string>
  <key>StandardErrorPath</key>
  <string>/PATH/TO/potus-live-bot/data/agent.log</string>
</dict>
</plist>
