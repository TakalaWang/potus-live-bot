{
  "name": "potus-live-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "replay": "node dist/index.js --replay",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "download-model": "bash scripts/download-model.sh",
    "register-commands": "node scripts/register-commands.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "discord.js": "^14.26.4",
    "onnxruntime-node": "^1.26.0",
    "yahoo-finance2": "^3.15.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.28.0"
}
