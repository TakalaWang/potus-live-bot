# Discord bot token (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=

# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# Multi-server mode (public bot): the Worker's subscription registry.
# Channels are managed by server admins via /subscribe — no channel id here.
# SUBSCRIPTIONS_URL=https://your-worker.workers.dev/subscriptions
# SUBSCRIPTIONS_SECRET=

# Single-channel self-host mode (legacy alternative to the above)
# DISCORD_CHANNEL_ID=

# YouTube channel /live URL to monitor (24/7 mode only)
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@WhiteHouse/live

# Polling interval in seconds (24/7 mode only)
POLL_INTERVAL_SEC=60

# Directory for dedup state and transcripts
DATA_DIR=./data
