# Discord bot token (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=

# Target text channel ID (enable Developer Mode, right-click channel → Copy ID)
DISCORD_CHANNEL_ID=

# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# YouTube channel /live URL to monitor
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@WhiteHouse/live

# Polling interval in seconds
POLL_INTERVAL_SEC=60

# Directory for dedup state and transcripts
DATA_DIR=./data
