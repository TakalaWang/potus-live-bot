# Discord bot token（Discord Developer Portal → Bot → Token）
DISCORD_BOT_TOKEN=

# 要推播的文字頻道 ID（開發者模式下右鍵頻道 → 複製 ID）
DISCORD_CHANNEL_ID=

# Google AI Studio 的 Gemini API key
GEMINI_API_KEY=

# 監測的 YouTube 頻道 /live 網址
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@WhiteHouse/live

# 輪詢間隔（秒）
POLL_INTERVAL_SEC=60

# 狀態與逐字稿存放目錄
DATA_DIR=./data
